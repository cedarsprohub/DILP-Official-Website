# Copy to .env and fill in. Never commit the filled-in file.

# --- where the enquiry is sent -------------------------------------------
MAIL_TO=partnerships@cedarsprohub.com

# --- the mailbox the service sends FROM ----------------------------------
# Must be an address your SMTP account is allowed to send as, otherwise the
# message is rejected or lands in spam.
MAIL_FROM=website@cedarsprohub.com
MAIL_FROM_NAME=DILP website

# --- SMTP ----------------------------------------------------------------
# Your mail provider gives you these. Examples:
#   Google Workspace : smtp.gmail.com      587  starttls  (needs an App Password)
#   Microsoft 365    : smtp.office365.com  587  starttls
#   Zoho             : smtp.zoho.com       465  ssl
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=

# --- who may post here ----------------------------------------------------
# Comma separated, no trailing slash. Add localhost while testing.
ALLOWED_ORIGINS=https://dessy-jay.github.io,http://localhost:4323

# --- abuse ----------------------------------------------------------------
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=3600
